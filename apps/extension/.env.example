# Variáveis da extensão (prefixo WXT_ para serem expostas ao bundle).
# Copie para apps/extension/.env
WXT_SUPABASE_URL="https://[ref].supabase.co"
WXT_SUPABASE_ANON_KEY=""
WXT_API_BASE_URL="http://localhost:3000"
# Observabilidade (opcional): sem DSN, o Sentry da extensão fica inerte.
WXT_SENTRY_DSN=""
