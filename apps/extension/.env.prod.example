WXT_SUPABASE_ANON_KEY="cole-a-anon-key-do-projeto-de-producao"
# Troque pela URL real do deploy na Vercel (ou seu domínio próprio).
WXT_API_BASE_URL="https://SEU-APP.vercel.app"
# Observabilidade (opcional).
WXT_SENTRY_DSN=""
