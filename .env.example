# ============================================================================
# Morubi — variáveis de ambiente (único arquivo de referência do monorepo)
# Copie para apps/web/.env.local para desenvolvimento local.
# ============================================================================

# --- Banco de dados (Supabase Postgres) ---
# Pooled connection (usada pela app em runtime)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (usada pelo Prisma migrate)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Supabase Auth / Storage ---
NEXT_PUBLIC_SUPABASE_URL=https://knfhosweddzfkgtyosbl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- LLM (geração/raciocínio) ---
# Quem responde as chamadas de geração:
#   api  (padrão) Anthropic pela ANTHROPIC_API_KEY. ÚNICO valor válido em produção.
#   cli  Claude Code instalado na máquina, autenticado pela assinatura. Dev/demo local.
#        Requer o Claude Code instalado e logado (`claude` no terminal).
#   mock Respostas fixas, sem rede e sem custo. Para mexer em UI e fluxo.
AI_PROVIDER="api"
ANTHROPIC_API_KEY=""

# Ajustes opcionais do AI_PROVIDER=cli:
# CLAUDE_CLI_PATH=""            # caminho do executável, se não estiver no PATH
# CLAUDE_CLI_CONCURRENCY="2"    # processos simultâneos (cada chamada é um processo)
# CLAUDE_CLI_TIMEOUT_MS="180000" # teto por chamada (o CLI é lento: ~20s por análise)

# --- Embeddings + Transcrição (Google Gemini) ---
GEMINI_API_KEY=""

# --- Observabilidade (Sentry) — opcional; sem DSN, tudo fica inerte ---
SENTRY_DSN=""
# Mesma DSN, exposta ao browser (erros de client). Pode repetir o valor acima.
NEXT_PUBLIC_SENTRY_DSN=""
# Só para upload de source maps no build (opcional): org/projeto + auth token.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- URL base da API (consumida pela extensão) ---
# Em dev: http://localhost:3000  | Em prod: https://app.morubi.com
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"
