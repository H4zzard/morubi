# ============================================================================
# Morubi — variáveis de ambiente (único arquivo de referência do monorepo)
# Copie para apps/web/.env.local para desenvolvimento local.
# ============================================================================

# --- Banco de dados (Supabase Postgres) ---
# Pooled connection (usada pela app em runtime)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (usada pelo Prisma migrate)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Supabase Auth / Storage ---
NEXT_PUBLIC_SUPABASE_URL=https://knfhosweddzfkgtyosbl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- LLM (geração/raciocínio) ---
ANTHROPIC_API_KEY=""

# --- Embeddings + Transcrição (Google Gemini) ---
GEMINI_API_KEY=""

# --- Observabilidade (Sentry) — opcional; sem DSN, tudo fica inerte ---
SENTRY_DSN=""
# Mesma DSN, exposta ao browser (erros de client). Pode repetir o valor acima.
NEXT_PUBLIC_SENTRY_DSN=""
# Só para upload de source maps no build (opcional): org/projeto + auth token.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- URL base da API (consumida pela extensão) ---
# Em dev: http://localhost:3000  | Em prod: https://app.morubi.com
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"
