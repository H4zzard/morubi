{
  "name": "@morubi/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../apps/web/.env.local -- prisma migrate deploy",
    "migrate:dev": "dotenv -e ../../apps/web/.env.local -- prisma migrate dev",
    "push": "dotenv -e ../../apps/web/.env.local -- prisma db push",
    "seed": "dotenv -e ../../apps/web/.env.local -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../../apps/web/.env.local -- prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@morubi/config": "workspace:*",
    "@types/node": "^22.10.5",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
